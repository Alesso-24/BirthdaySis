---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Chapter from '../components/Chapter.astro';
import Letter from '../components/Letter.astro';
import { site } from '../data/site';

const mods = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const photos = new Map<number, ImageMetadata>();
for (const [path, mod] of Object.entries(mods)) {
  const m = path.match(/p(\d+)\.jpg$/);
  if (m) photos.set(parseInt(m[1], 10), mod.default);
}

const accents = [
  { accent: '#e0476a', tint: '#f7a9bb' },
  { accent: '#4f93d6', tint: '#a9cdf2' },
  { accent: '#4fa37a', tint: '#a9d6b8' },
];

const chapters = await Promise.all(
  site.chapters.map(async (ch) => ({
    ...ch,
    items: await Promise.all(
      ch.photos
        .filter((n) => photos.has(n))
        .map(async (n) => {
          const src = photos.get(n)!;
          const full = await getImage({ src, width: 1000, format: 'webp', quality: 80 });
          return { n, src, full: full.src, cap: site.captions[String(n)] ?? '' };
        })
    ),
  }))
);
---
<Base title={`Feliz cumpleaños, ${site.name}`}>
  <Hero name={site.name} age={site.age} />

  <main id="collage">
    {chapters.map((ch, i) => (
      <Chapter num={ch.num} title={ch.title} note={ch.note} items={ch.items} accent={accents[i % 3].accent} tintAccent={accents[i % 3].tint} />
    ))}
  </main>

  <Letter title={site.letterTitle} lines={site.letter} from={site.from} />

  <dialog id="lb" aria-label="Foto ampliada">
    <button class="lb-x" type="button" aria-label="Cerrar">✕</button>
    <button class="lb-prev" type="button" aria-label="Anterior">‹</button>
    <figure class="lb-fig">
      <div class="lb-frame"><span class="lb-tape"></span><img alt="" /></div>
      <figcaption class="hand"></figcaption>
    </figure>
    <button class="lb-next" type="button" aria-label="Siguiente">›</button>
  </dialog>

  <script>
    import '../scripts/main';
  </script>
</Base>

<style is:global>
  dialog#lb { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100dvh; width: 100%; height: 100%; overflow: hidden; }
  dialog#lb::backdrop { background: rgba(43, 28, 28, 0.88); }
  dialog#lb[open] { display: grid; grid-template-columns: 3.6rem 1fr 3.6rem; align-items: center; justify-items: center; }
  .lb-fig { grid-column: 2; margin: 0; display: flex; flex-direction: column; align-items: center; max-width: 100%; }
  .lb-frame { position: relative; background: #fffdf8; padding: 12px; box-shadow: 0 24px 50px rgba(0, 0, 0, 0.5); }
  .lb-frame img { display: block; max-width: min(86vw, 900px); max-height: 74dvh; width: auto; height: auto; }
  .lb-tape {
    position: absolute; top: -13px; left: 50%; width: 96px; height: 28px; margin-left: -48px; transform: rotate(-3deg);
    background: #fbe29a; opacity: 0.92; background-image: repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.4) 0 5px, transparent 5px 11px);
  }
  dialog#lb figcaption { color: #fff; font-size: 2rem; margin-top: 0.8rem; min-height: 2rem; }
  dialog#lb button {
    background: #fffdf8; color: var(--ink); border: 3px solid var(--ink); border-radius: 50%; width: 2.9rem; height: 2.9rem;
    font-size: 1.7rem; line-height: 1; cursor: pointer; box-shadow: 3px 3px 0 var(--ink); transition: transform 0.15s;
  }
  dialog#lb button:hover { transform: translate(-1px, -1px) rotate(-4deg); }
  dialog#lb button:focus-visible { outline: 3px solid var(--sky); outline-offset: 3px; }
  .lb-prev { grid-column: 1; grid-row: 1; } .lb-next { grid-column: 3; grid-row: 1; }
  .lb-x { position: fixed; top: 1rem; right: 1rem; }
  @media (max-width: 560px) {
    dialog#lb[open] { grid-template-columns: 2.4rem 1fr 2.4rem; }
    dialog#lb button { width: 2.3rem; height: 2.3rem; font-size: 1.4rem; box-shadow: 2px 2px 0 var(--ink); }
    .lb-frame { padding: 8px; }
  }
</style>
